{
  "name": "zzz-translate",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "description": "젠레스 존 제로 용어를 반영하는 Discord 채널 번역 봇",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "register": "node --env-file-if-exists=.env src/register.js",
    "check": "node --env-file-if-exists=.env scripts/check.js",
    "test": "node --test test/core.test.js test/glossary.test.js test/glossary-tags.test.js test/providers.test.js test/guild-api.test.js test/media.test.js test/reports.test.js test/selfhost.test.js",
    "runner": "node --env-file-if-exists=.env.runner scripts/discord-runner.mjs start",
    "runner:pair": "node --env-file-if-exists=.env.runner scripts/discord-runner.mjs pair",
    "runner:usage": "node --env-file-if-exists=.env.runner scripts/discord-runner.mjs usage",
    "runner:ui": "node scripts/runner-ui.mjs",
    "runner:build": "node scripts/runner-build.mjs",
    "local": "node --env-file-if-exists=.env scripts/local-ai.js",
    "glossary:build": "node scripts/build-glossary.js",
    "glossary:download": "node scripts/build-glossary.js --download",
    "glossary:sync": "node scripts/sync-glossary.mjs sync",
    "glossary:apply": "node scripts/sync-glossary.mjs apply",
    "reports": "node scripts/reports-cli.mjs"
  },
  "dependencies": {
    "discord.js": "^14.22.1"
  }
}
